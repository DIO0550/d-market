{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Glob|Grep",
        "hooks": [
          {
            "type": "command",
            "command": "bash plugins/file-search-plugin/hooks/file-search-redirect.sh"
          }
        ]
      },
      {
        "matcher": "WebSearch|WebFetch",
        "hooks": [
          {
            "type": "command",
            "command": "bash plugins/file-search-plugin/hooks/web-search-redirect.sh"
          }
        ]
      }
    ]
  }
}
